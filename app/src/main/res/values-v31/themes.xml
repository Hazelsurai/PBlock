        <item name="windowSplashScreenBackground">@color/pb_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/saworks_badge</item>
        <item name="postSplashScreenTheme">@style/Theme.PBlock</item>
    </style>
</resources>
