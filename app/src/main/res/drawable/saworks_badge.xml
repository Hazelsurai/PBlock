<?xml version="1.0" encoding="utf-8"?>
<!-- SAWorks logo on a light rounded card (the logo's black outline is not legible on black). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="68dp"
        android:height="76dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/pb_brand_card" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="58dp"
        android:height="66dp"
        android:gravity="center">
        <bitmap
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/saworks_logo" />
    </item>
</layer-list>
